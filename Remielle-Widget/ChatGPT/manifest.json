{
  "manifest_version": 3,
  "name": "ChatGPT",
  "version": "1.0",
  "description": "Shows an animated AI assistant widget on chatgpt.com to indicate conversation states in real-time.",
  "content_scripts": [
    {
      "matches": ["*://chatgpt.com/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*.gif"],
      "matches": ["*://chatgpt.com/*"]
    }
  ]
}
