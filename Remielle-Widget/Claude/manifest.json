{
  "manifest_version": 3,
  "name": "Claude",
  "version": "1.0",
  "description": "Shows an animated AI assistant widget on claude.ai to indicate conversation states in real-time.",
  "content_scripts": [
    {
      "matches": ["*://claude.ai/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*.gif"],
      "matches": ["*://claude.ai/*"]
    }
  ]
}
